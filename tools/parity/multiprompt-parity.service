[Unit]
Description=Keep Multiprompt desktop and Android requests paired

[Service]
Type=oneshot
Environment="CEO_AGENT=Hax Runner 14"
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=-/usr/bin/git -C %h/projects/multiprompt-android-jobs fetch --depth 1 origin main
ExecStartPre=-/usr/bin/git -C %h/projects/multiprompt-android-jobs checkout -q --detach origin/main
ExecStart=/usr/bin/python3 %h/projects/multiprompt-android-jobs/tools/parity/multiprompt-parity.py --apply
UMask=0077

+@Composable
+private fun ChatTable(
+    table: MdBlock.Table,
+    fontSize: TextUnit,
+    color: Color,
+    linkColor: Color,
+    codeBg: Color,
+    title: String?,
+) {
+    var open by remember { mutableStateOf(false) }
+    Box {
+        MarkdownTable(table, fontSize, color, linkColor, codeBg)
+        KitExpandButton(
+            onClick = { open = true },
+            modifier = Modifier.align(Alignment.TopEnd).padding(6.dp).testTag("table-expand"),
+        )
+    }
+    if (open) {
+        KitSheet(onDismiss = { open = false }) {
+            ExpandedChatTable(table, fontSize, title) { open = false }
+        }
+    }
+}
